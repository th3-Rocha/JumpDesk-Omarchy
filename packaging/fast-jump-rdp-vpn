#!/bin/bash
# Helper root da VPN. Instalado em /usr/local/libexec/fast-jump-rdp-vpn e
# executado via pkexec (regra polkit permite sem senha para o grupo definido).
#
# Lê o openvpn como argumentos ($@) e repassa; as credenciais chegam pelo STDIN
# (2 linhas: usuário, senha+código). Elas vão para um arquivo só do root em
# /run, que substitui o `/dev/stdin` dos args — o openvpn lê as credenciais
# quando quer (e de novo em reconexões), e um pipe já estaria vazio. O arquivo
# é apagado quando o openvpn termina. Nada de senha em argv.
set -euo pipefail

if [[ $EUID -ne 0 ]]; then
  echo "este helper precisa rodar como root (via pkexec)" >&2
  exit 1
fi

# Remove interfaces tunN do openvpn (tun ou ovpn/DCO) que ficaram sem dono —
# sobra de um openvpn que morreu sem limpar (SIGKILL, crash). As rotas da VPN
# ficam presas nelas e, como a sessão nova cai na mesma sub-rede, o kernel
# manda o tráfego da rede interna pela interface morta. Apagar a interface
# leva junto as rotas presas nela.
#   $1 = all  → todas (usado depois de matar todo openvpn)
#   senão     → só as DOWN (uma interface viva de outro openvpn fica)
remove_orphan_ifaces() {
  local mode="${1:-down}" p dev
  for p in /sys/class/net/tun*; do
    [[ -e "$p" ]] || continue
    dev="${p##*/}"
    [[ "$dev" =~ ^tun[0-9]+$ ]] || continue
    [[ -e "$p/tun_flags" ]] || ip -d -o link show dev "$dev" 2>/dev/null | grep -qw ovpn || continue
    if [[ "$mode" != all && "$(cat "$p/operstate" 2>/dev/null)" != down ]]; then
      continue
    fi
    ip link del "$dev" 2>/dev/null && echo "removi a interface órfã $dev (e as rotas presas nela)"
  done
  return 0
}

# --stop: encerra todo openvpn rodando (do app ou de um script antigo). O app
# não consegue matar sozinho, porque o openvpn roda como root. Dá tempo para o
# TERM (o openvpn remove interface e rotas sozinho); se precisar de KILL, a
# interface fica para trás e é removida aqui.
if [[ "${1:-}" == "--stop" ]]; then
  pkill -TERM -x openvpn || true
  for _ in $(seq 20); do
    pgrep -x openvpn >/dev/null || break
    sleep 0.3
  done
  pkill -KILL -x openvpn || true
  sleep 0.3
  remove_orphan_ifaces all
  exit 0
fi

# Apenas o openvpn é permitido; valida que o primeiro arg é --config.
if [[ "${1:-}" != "--config" ]]; then
  echo "uso restrito: esperado --config como primeiro argumento" >&2
  exit 2
fi

# Antes de subir: tira interfaces mortas de sessões antigas, senão a nova
# vira tun1 e as rotas continuam apontando para o tun0 morto.
remove_orphan_ifaces

umask 077
AUTH="$(mktemp /run/fast-jump-rdp-auth.XXXXXX)"
trap 'rm -f "$AUTH"' EXIT
head -n 2 > "$AUTH"

args=()
for a in "$@"; do
  [[ "$a" == /dev/stdin ]] && a="$AUTH"
  args+=("$a")
done

/usr/bin/openvpn "${args[@]}" &
pid=$!
trap 'kill -TERM "$pid" 2>/dev/null' TERM INT
set +e
wait "$pid"; rc=$?
# Se o helper levou TERM, o wait volta antes do openvpn sair: espera de novo.
while kill -0 "$pid" 2>/dev/null; do wait "$pid"; rc=$?; done
exit "$rc"
